# GCP / BigQuery
BQ_PROJECT=oppo-gcp-prod-digfood-129869
BQ_LOCATION=asia-southeast2
# Comma-separated allowlist (read-only)
BQ_ALLOWED_DATASETS=qpon_rpt_d,qpon_dws_d,qpon_dwd_d
BQ_MAX_BYTES_BILLED=10737418240
BQ_MAX_ROWS=500
BQ_QUERY_TIMEOUT_SEC=60

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Feishu app (event subscription bot)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Optional: restrict who can ask (comma-separated open_id). Empty = allow all.
FEISHU_ALLOWLIST_OPEN_IDS=

# Local HTTP ask (keep false on Cloud Run)
ENABLE_HTTP_ASK=false
ASK_API_KEY=

# Runtime
LOG_LEVEL=INFO
PORT=8080